FUll outer JOIN

1.Show all customers and all orders

select  c.name ,o.amount
from customers c
left join orders o
on c.id = o.customer_id
union
select c.name , o.amount
from customers c
right join orders o
on c.id = o.customer_id;


2.Show unmatched customers and unmatched orders together

select c.name 
from customers c
left join orders o
on c.id = o.customer_id
where o.customer_id is NULL
union
select o.customer_id
from customers c
right join orders o
on c.id = o.customer_id
where c.id is NULL;

3.Count all rows from FULL OUTER JOIN result

SELECT COUNT(*)
FROM (
    SELECT c.name, o.amount
    FROM customers c
    LEFT JOIN orders o
    ON c.id = o.customer_id

    UNION

    SELECT c.name, o.amount
    FROM customers c
    RIGHT JOIN orders o
    ON c.id = o.customer_id
) AS full_data;





