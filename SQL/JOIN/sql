INNER JOIN

1.Show customer names with order amount
select c.name ,o.amount
from customers c
INNER join orders o
on c.id = o.customer_id;

2.Show customer names with amount > 500
select c.name , o.amount
from customers c
INNER JOIN orders o
on c.id = o.customer_id
where o.amount>500;

3.Show total amount spent by each customer
select c.name , sum(o.amount)
from customers c
INNER JOIN orders o
on c.id = o.customer_id
group by c.name;

4.Show customer names sorted by total amount spent
select c.name , sum(o.amount)
from customers c
INNER JOIN orders o
on c.id = o.cutomer_id
groub by c.name
order by sum(o.amount) DESC;

5.Find customer who spent the highest amount total.
select c.name , sum(o.amount) AS TOTAL_AMOUNT
from customers c
INNER JOIN orders o
on c.id = o.customer_id
group by c.name
order by TOTAL_AMOUNT DESC
LIMIT 1;






